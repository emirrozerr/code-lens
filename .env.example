# =============================================================================
# CodeLens Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=codelens_dev
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- LLM (Domain Summaries) ---
# Google Gemini API key for domain naming and summarisation.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- JWT Auth ---
# Secret key for signing JWT tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
# Set to true in production (HTTPS only)
JWT_COOKIE_SECURE=false

# --- Admin ---
# Initial password for admin@codelens.dev seeded on first startup.
# Change before any shared deployment.
ADMIN_INITIAL_PASSWORD=admin123

# --- LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile

# --- App ---
LOG_LEVEL=INFO
DEBUG=false
